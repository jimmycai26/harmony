# Cloudflare R2 credentials (S3-compatible object storage).
# All values below are dummy placeholders — replace with real values once
# a Cloudflare account + R2 bucket exist. See README.md for setup steps.

# Cloudflare account ID. Found in the Cloudflare dashboard sidebar, or via
# `wrangler whoami`. Used to build the R2 S3-compatible endpoint URL:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=00000000000000000000000000dead

# R2 API token credentials (Cloudflare dashboard -> R2 -> Manage API Tokens).
# Create a token scoped to "Object Read & Write" on the Harmony bucket only.
R2_ACCESS_KEY_ID=dummy_r2_access_key_id
R2_SECRET_ACCESS_KEY=dummy_r2_secret_access_key_00000000000000000000

# Name of the R2 bucket that stores generated audio tracks + peaks JSON.
R2_BUCKET_NAME=harmony-audio-dev
