# Copy to `.env` and fill in real values once keys exist. Until then, leave
# these as-is (or unset) — any value starting with `dummy-` is treated as
# "not configured" and every adapter transparently falls back to its
# in-memory mock instead of calling the real API. See README.md.

STABLE_AUDIO_API_KEY=dummy-key-pending

# Lyria 2 runs on Vertex AI, which needs a GCP project (and optionally a
# non-default region) in addition to a credential.
LYRIA2_API_KEY=dummy-key-pending
LYRIA2_PROJECT_ID=dummy-project-pending
LYRIA2_LOCATION=us-central1

ELEVENLABS_API_KEY=dummy-key-pending

# MiniMax scopes API keys under a "group"; both are required.
MINIMAX_API_KEY=dummy-key-pending
MINIMAX_GROUP_ID=dummy-group-pending
